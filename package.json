{
  "name": "auriclabs-packages",
  "private": true,
  "version": "0.0.0",
  "prettier": "@auriclabs/prettier-config",
  "packageManager": "pnpm@9.0.6",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:affected": "turbo run build --filter=...[origin/master]",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:affected": "turbo run test --filter=...[origin/master]",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:staged": "lint-staged",
    "lint:affected": "turbo run lint --filter=...[origin/master]",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --filter=...[origin/master]",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "chokidar": "4.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "9.36.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "ts-node": "^10.9.2",
    "tsdown": "0.21.4",
    "tsup": "8.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@auriclabs/env": "workspace:*",
    "@auriclabs/eslint-config": "workspace:*",
    "@auriclabs/logger": "workspace:*",
    "@auriclabs/prettier-config": "workspace:*",
    "@auriclabs/sst-types": "workspace:*",
    "@auriclabs/ts-config": "workspace:*",
    "@auriclabs/vitest-config": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "hono@<4.9.7": ">=4.9.7",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11",
      "hono@>=1.1.0 <4.10.2": ">=4.10.2",
      "hono@<4.10.3": ">=4.10.3",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "glob@>=11.0.0 <11.1.0": ">=11.1.0",
      "body-parser@>=2.2.0 <2.2.1": ">=2.2.1",
      "@modelcontextprotocol/sdk@<1.24.0": ">=1.24.0",
      "lodash-es@>=4.0.0 <=4.17.22": ">=4.17.23",
      "tar@<7.5.7": ">=7.5.7",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "diff@>=6.0.0 <8.0.3": ">=8.0.3",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "axios@>=1.0.0 <=1.13.4": ">=1.13.5",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "minimatch@>=10.0.0 <10.2.4": ">=10.2.4",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=10.0.0": ">=10.2.4",
      "eslint-plugin-import>minimatch": "10.2.4",
      "eslint-plugin-react>minimatch": "10.2.4",
      "ajv@<6.14.0": ">=6.14.0",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "tar@<=7.5.9": ">=7.5.10",
